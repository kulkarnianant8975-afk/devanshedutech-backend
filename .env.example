# Local development. Copy to .env and fill in.
# Production is configured through the host environment, not this file.
# See DEPLOYMENT.md for the full list and what each setting does.

# Required — the application will not start without these.
DATABASE_PASSWORD=change-me
DATABASE_USERNAME=devanshedutech
DATABASE_NAME=devanshedutech

# Bootstrap access: this address gets Super Admin on first sign-in.
SUPER_ADMIN_EMAILS=

# The first entry is also the post-login redirect target.
# Where you will open the app. The first entry is also the post-login redirect target.
ALLOWED_ORIGINS=http://localhost:8000

# Local staging is plain HTTP, so the session cookie cannot be marked secure.
# Leave this unset (defaults to true) anywhere reachable from the internet.
COOKIE_SECURE=false

# Optional. Leave these lines commented out unless you have real values.
#
# Do NOT set GOOGLE_CLIENT_ID to an empty string. Spring rejects an empty client id at
# startup with "Client id must not be empty", and an empty variable counts as set, so it
# overrides the default. Omitting the line entirely is what you want.
# GEMINI_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# The daily follow-up pass changes lead grades on a schedule. Off locally by default.
LADDER_ENABLED=false

# WhatsApp sending.
#
# Leave AISENSY_API_KEY empty and the swipe opens the message in your own WhatsApp to send by
# hand — which works with no account at all. Set it, and the swipe delivers to the student
# directly through AiSensy.
#
# PUBLIC_BASE_URL is the public address of this application, and two things need it. WhatsApp
# fetches attachments from their URL using its own servers, so a relative path or localhost is
# accepted by the API and then silently never arrives. And tracked assets are sent as links back
# through this address, which is what makes "opened the syllabus three times" possible.
#
# Left empty, attachments are sent as plain links and opens are not counted. That is the honest
# degradation: a working file on the student's phone matters more than the statistic.
# AISENSY_API_KEY=
# AISENSY_CAMPAIGN=crm_message
# PUBLIC_BASE_URL=https://your-domain.com
